{
  "name": "pill",
  "version": "0.5.0",
  "description": "Une capsule flottante pour macOS : horloge, presse-papiers, minuteurs, notes, système et lanceur.",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --mac"
  },
  "keywords": [
    "macos",
    "electron",
    "clipboard",
    "widget",
    "pill"
  ],
  "license": "MIT",
  "devDependencies": {
    "electron": "^44.5.1",
    "electron-builder": "^26.0.0"
  },
  "build": {
    "appId": "local.pill.app",
    "productName": "Pill",
    "files": [
      "main.js",
      "preload.js",
      "index.html",
      "assets/**/*",
      "fonts/**/*",
      "package.json"
    ],
    "mac": {
      "icon": "build/icon.png",
      "category": "public.app-category.utilities",
      "target": [
        "dmg"
      ],
      "extendInfo": {
        "LSUIElement": true
      }
    }
  }
}
